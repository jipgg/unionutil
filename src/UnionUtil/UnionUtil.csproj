<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
     <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TargetFrameworks>net10.0;net9.0;net8.0;net7.0</TargetFrameworks>
    <LangVersion>14</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
     <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
     <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>

     <IsPackable>true</IsPackable>
     <PackageId>UnionUtil</PackageId>
     <Version>0.1.1</Version>
     <Authors>jipg</Authors>
     <PackageLicenseExpression>MIT</PackageLicenseExpression>
     <RepositoryUrl>https://github.com/jipgg/unionutil</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
     <Compile Include="../shared/**/*.cs" />
     <Compile Include="../generated/**/*.cs" />
     <None Include="../../README.md" Pack="true" PackagePath="/" />
     <ProjectReference Include="..\UnionUtil.Meta\UnionUtil.Meta.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
     <Content Include="..\UnionUtil.Meta\bin\$(Configuration)\netstandard2.0\UnionUtil.Meta.dll" Pack="true" PackagePath="analyzers/dotnet/cs/" />
  </ItemGroup>
  <!-- <Target Name="GenerateBoilerplate"  BeforeTargets="CoreCompile"> -->
  <!--     <Exec Command="../../scripts/generate-boilerplate.cs" /> -->
  <!--  <ItemGroup> -->
  <!--     <Compile Include="../generated/GenericOverloads.g.cs" /> -->
  <!--  </ItemGroup> -->
<!-- </Target> -->
</Project>
