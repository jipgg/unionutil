<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
     <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
     <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
     <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>

     <IsPackable>true</IsPackable>
     <PackageId>UnionUtil</PackageId>
     <Version>0.0.1</Version>
     <Authors>jipg</Authors>
     <PackageLicenseExpression>MIT</PackageLicenseExpression>
     <RepositoryUrl>https://github.com/jipgg/unionutil</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
     <None Include="../.,/../../README.md" Pack="true" PackagePath="/" />
     <ProjectReference Include="..\Generators\UnionUtil.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
     <Content Include="..\Generators\bin\$(Configuration)\netstandard2.0\UnionUtil.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs/" />
     <ProjectReference Include="..\InternalGenerators\UnionUtil.Internal.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Shared\UnionUtil.Shared.csproj" />
  </ItemGroup>

</Project>
